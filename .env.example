# ==============================================================================
# VeriDoc — Environment Variables Template (Isolated Schema: veridoc)
# Copy this file to .env.local and populate the secrets.
# NEVER commit .env.local or production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connections (Supabase PostgreSQL — Isolated in 'veridoc' schema)
# ------------------------------------------------------------------------------
# Runtime pooled connection string (port 6543) connecting as dedicated veridoc_app_user (NOBYPASSRLS).
# Used by Drizzle ORM inside withTenantContext() with transaction-scoped SET LOCAL.
DATABASE_URL="postgresql://veridoc_app_user:YOUR_VERIDOC_APP_USER_PASSWORD@YOUR_POOLER_HOST:6543/postgres?sslmode=require"

# Direct connection string (port 5432) connecting as migration/admin role (postgres).
# Used exclusively for DDL schema migrations (pnpm db:migrate / pnpm db:generate).
DIRECT_DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@YOUR_DIRECT_HOST:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Authentication (Better Auth)
# ------------------------------------------------------------------------------
# Cryptographically secure random secret (min 32 bytes) for signing sessions and tokens.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-this-to-a-secure-32-byte-secret-in-production"

# Canonical base URL for Better Auth handlers and email verification links.
BETTER_AUTH_URL="http://localhost:3000"

# Public application URL consumed by client components and notification links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Private Storage (Supabase Storage — Dedicated Bucket)
# ------------------------------------------------------------------------------
# Supabase project URL for Storage endpoint resolution.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"

# Supabase Publishable / Anon Key (if needed for client-side storage references)
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# Privileged server-only service role key for private bucket ops and 120s signed URLs.
# NEVER expose this key to client components or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Dedicated private bucket name storing controlled SOP PDFs (<= 50MB).
SUPABASE_STORAGE_BUCKET="veridoc-controlled-docs"

# ------------------------------------------------------------------------------
# 4. Cryptographic Audit Chain (DEC-08)
# ------------------------------------------------------------------------------
# Domain separator prepended in the canonical audit hash formula.
# Required in production (NODE_ENV=production); set once at first deployment.
AUDIT_HASH_SALT="veridoc_production_v1"

# ------------------------------------------------------------------------------
# 5. Transactional Notifications (INotificationProvider)
# ------------------------------------------------------------------------------
# Resend API key for post-commit transactional email delivery.
# Leave empty in local dev to fall back to console logging.
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL="notifications@veridoc.workspace"

# ------------------------------------------------------------------------------
# 6. Optional Runtime & Demo Controls
# ------------------------------------------------------------------------------
# Optional max connections per serverless DB pool instance (defaults to 5).
DB_POOL_MAX="5"

# Optional override to enable quick demo role sign-in in production previews (defaults to disabled in production).
ENABLE_DEMO_LOGIN="false"
